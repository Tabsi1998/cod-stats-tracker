<Window x:Class="CodStats.Desktop.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="520" Height="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Style="{StaticResource DarkWindow}" Icon="/Assets/app.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Einstellungen" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

            <TextBlock Style="{StaticResource Label}" Text="SPIELERNAME" />
            <TextBox x:Name="NameBox" Margin="0,4,0,4" MaxLength="40" />
            <CheckBox x:Name="NameConfirmed" Content="Das ist mein eigener CoD-Name (einmalig bestätigen)" />
            <TextBlock Margin="0,2,0,12" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"
                       Text="Solange die automatische Erkennung fehlt, trägst du deinen Namen hier einmal ein. Ohne Bestätigung wird dein Profil nicht veröffentlicht." />

            <CheckBox x:Name="Publish" Content="Profil öffentlich auf der Webseite zeigen" />
            <CheckBox x:Name="Tracking" Content="Tracking aktiv" />
            <CheckBox x:Name="Autostart" Content="Mit Windows starten (im Tray)" />

            <TextBlock Style="{StaticResource Label}" Text="SERVERADRESSE" Margin="0,12,0,4" />
            <TextBox x:Name="Server" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Speichern" Style="{StaticResource Primary}" Click="OnSave" />
            </StackPanel>
            <TextBlock x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="PROFIL AUF ANDEREN PC ÜBERTRAGEN" />
                    <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"
                               Text="Erzeuge hier einen Wiederherstellungsschlüssel und bewahre ihn sicher auf (Passwortmanager). Auf dem neuen PC gibst du ihn unten ein. Danach gilt nur noch der neue PC." />
                    <Button Content="Wiederherstellungsschlüssel erzeugen" HorizontalAlignment="Left" Click="OnCreateRecovery" />
                    <TextBox x:Name="RecoveryShown" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Label}" Text="SCHLÜSSEL VOM ALTEN PC EINGEBEN" Margin="0,12,0,4" />
                    <TextBox x:Name="RecoveryInput" FontFamily="Consolas" />
                    <Button Content="Profil auf diesen PC holen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRecover" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="DEINE DATEN" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Alle Daten exportieren (JSON)" Click="OnExport" Margin="0,0,8,0" />
                        <Button Content="Alle Daten löschen" Click="OnDelete" Foreground="{StaticResource Loss}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
