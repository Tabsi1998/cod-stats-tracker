{
	servers {
		# Requests from these addresses may name the real client in X-Forwarded-For: your own reverse proxy.
		# Without this every visitor would carry the proxy's address and share one rate limit.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Forwarded-For
	}
}

# A domain (Caddy fetches the certificate) or ":80" behind your own reverse proxy that handles HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'"
		-Server
	}

	# Link previews: chat apps and social sites read the page without running it. Only their crawlers get a small
	# page with the profile's or match's numbers from the API; people get the website. If the API is down, the
	# preview is missing and nothing else.
	@share {
		path_regexp ^/player/[0-9a-fA-F-]{36}(/match/[0-9a-fA-F-]{36})?/?$
		header_regexp User-Agent (?i)(discordbot|twitterbot|facebookexternalhit|facebookcatalog|whatsapp|telegrambot|slackbot|linkedinbot|skypeuripreview|redditbot|mastodon|embedly|iframely)
	}
	handle @share {
		uri strip_suffix /
		rewrite * /api/v1/public/share{path}
		reverse_proxy api:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	@api path /api/* /openapi/* /health
	handle @api {
		reverse_proxy api:8080 {
			# Exactly one address for the API: the real client, as Caddy determined it above.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The Windows installer (deploy/downloads on the server). A missing file is a 404, not the start page.
	handle /downloads/* {
		root * /srv
		header Content-Disposition attachment
		# Always ask the server: an installer cached from before an update installs the old version.
		header Cache-Control "no-cache"
		file_server
	}

	# Built files carry their content hash in the name and never change; the start page must always be fresh,
	# or an open browser keeps asking for files an update removed.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/* /api/* /openapi/* /health /downloads/*
	header @page Cache-Control "no-cache"

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
