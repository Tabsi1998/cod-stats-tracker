# Copy to .env and fill in. .env is never committed.

# Domain of the website. Caddy fetches the HTTPS certificate automatically.
# For a local test use: SITE_ADDRESS=http://localhost and HTTP_PORT=8080
SITE_ADDRESS=stats.example.com

# Long random value, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Matches a player needs before appearing in leaderboards
LEADERBOARD_MIN_MATCHES=20

HTTP_PORT=80
HTTPS_PORT=443
